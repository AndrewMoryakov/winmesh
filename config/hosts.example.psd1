@{
    # Значения по умолчанию для всех машин. Любое переопределяется в самой машине.
    Defaults = @{
        Transport       = 'winrm'                       # в этой версии только winrm

        CredentialStore = '~\.winmesh\creds'            # где лежат зашифрованные учётки

        # Подсети, которым разрешается порт WinRM (сужение брандмауэра в bootstrap).
        # Значение зависит от того, как связаны машины:
        #   Tailscale / NetBird  -> '100.64.0.0/10'  (диапазон CGNAT, по умолчанию)
        #   ZeroTier             -> подсеть вашей сети, например '10.147.17.0/24'
        #   обычная локальная сеть -> например '192.168.1.0/24'
        #   несколько сразу      -> @('192.168.1.0/24','100.64.0.0/10')
        #   не сужать (доверенный LAN) -> @()
        AllowedSubnets  = @('100.64.0.0/10')
    }

    # Машины парка. Ключ — короткое имя, которым вы будете называть машину.
    # Address — её адрес в вашей сети (оверлейный IP, LAN-адрес или DNS-имя).
    Hosts = @{
        'workstation-01' = @{
            Address    = '100.100.10.11'                # адрес в сети или DNS-имя
            Credential = 'admin@workstation-01'         # ид записи в хранилище
            Note       = 'пример: рабочая станция'
        }

        # 'nas-lan' = @{
        #     Address    = '192.168.1.50'               # пример: машина в локальной сети
        #     Credential = 'admin@nas-lan'
        # }
    }
}
